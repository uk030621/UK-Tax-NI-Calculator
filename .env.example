# MongoDB connection string (Atlas or self-hosted).
# Note: the database name at the end of this URI is NOT what the app
# actually uses — every query explicitly calls client.db(DB_NAME), which
# reads from MONGODB_DB_NAME below (or defaults to "tax_calculator"). You
# can leave any placeholder database name here, or omit it entirely.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# The actual database name the app reads/writes. Change this if
# "tax_calculator" already exists in your cluster for a different project.
MONGODB_DB_NAME=tax_calculator

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated Google account emails allowed to manage tax year rates
# at /admin/tax-years. Everyone else gets "Not authorized" on that page.
ADMIN_EMAILS=you@example.com,colleague@example.com

# General access — who can sign in and use the app at all — is NOT an
# environment variable anymore. It's managed from /admin/access once
# the app is running, stored in the allowed_emails collection, so it
# can be changed without a redeploy. Admins (above) are always
# implicitly allowed, so their address doesn't need adding there too.
# A fresh deployment starts locked down to admins only, until an admin
# adds people at /admin/access.
#
# If you're upgrading from an older version of this project that used
# an ALLOWED_EMAILS variable here, run `npm run migrate-allowed-emails`
# once to move those addresses into the database — see that script's
# comment for details. This variable is no longer read by the app at
# all once you've migrated.

# --- Stripe: pay-for-access (optional) -------------------------------
# All three are optional as a group. Leave them unset and the app works
# exactly as before — signed-in, allowed users use it for free, and the
# "Buy access" option simply doesn't appear. Set all three to turn on
# self-service paid access. See the README's "Setting up Stripe" section
# for exactly how to get each of these from the Stripe dashboard.

# Secret key — Developers > API keys. Starts sk_test_... while you're
# testing, sk_live_... only once you're ready to take real payments.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — Developers > Webhooks > your endpoint > Signing
# secret. This is what lets /api/webhooks/stripe trust that a request
# genuinely came from Stripe, not just anyone who knows the URL. Starts
# whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The one-time price, in pounds (not pence) — e.g. 9.99 for £9.99.
STRIPE_PRICE_GBP=9.99

# Optional: what the customer sees as the line item name on Stripe's
# Checkout page. Defaults to "UK Tax & NI Calculator — lifetime access"
# if you don't set this.
STRIPE_PRODUCT_NAME=UK Tax & NI Calculator — lifetime access
